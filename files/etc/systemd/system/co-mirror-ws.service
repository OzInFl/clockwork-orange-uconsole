[Unit]
Description=Clockwork Orange screen mirror WebSocket bridge (127.0.0.1:6081 -> co-mirror-vnc 127.0.0.1:5901)
After=network.target co-mirror-vnc.service
Wants=co-mirror-vnc.service

[Service]
User=pi
ExecStart=/usr/bin/websockify 127.0.0.1:6081 127.0.0.1:5901
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
