[Unit]
Description=Clockwork Orange ALPR Watch (Flock / Raven detector + known-camera alerts, :8095)
After=bluetooth.service NetworkManager.service gpsd.socket
Wants=bluetooth.service gpsd.socket

[Service]
User=pi
# XDG_RUNTIME_DIR lets pw-play reach the desktop session's PipeWire (alert sounds)
Environment=XDG_RUNTIME_DIR=/run/user/1000 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/clockwork-orange/alpr/alpr.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
