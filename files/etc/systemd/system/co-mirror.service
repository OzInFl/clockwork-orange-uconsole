[Unit]
Description=Clockwork Orange remote console (screen mirror + app launcher, HTTPS :6080)
After=network.target co-mirror-ws.service
Wants=co-mirror-ws.service

[Service]
User=pi
# The desktop session's environment, so apps it launches open on the uConsole screen
Environment=XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/clockwork-orange/mirror/mirror.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
